{
	"id": "nodebb-theme-custom",
	"hooks": [
		{ "hook": "filter:widgets.getAreas", "method": "defineWidgetAreas" },
		{ "hook": "filter:config.get", "method": "getThemeConfig" },
		{ "hook": "static:app.load", "method": "init" },
		{ "hook": "filter:admin.header.build", "method": "addAdminNavigation" },
		{ "hook": "filter:user.profileMenu", "method": "addProfileItem" },
        { "hook": "filter:composer.build", "method": "addCustomField" },
        { "hook": "filter:topic.create", "method": "saveCustomField" },
        { "hook": "filter:topics.get", "method": "getCustomField" }
    ],
	"scripts": [
		"public/modules/autohidingnavbar.js",
		"public/persona.js",
        "public/js/composer.js"
	],
	"modules": {
		"../admin/plugins/persona.js": "public/admin.js",
		"persona/taskbar.js": "public/modules/taskbar.js",
		"persona/mobile-menu.js": "public/modules/mobile-menu.js",
		"../client/account/theme.js": "public/settings.js"
	},
  "staticDirs": {
    "images": "./images"
  },
	"languages": "languages",
    "defaultLang": "en-US"
}